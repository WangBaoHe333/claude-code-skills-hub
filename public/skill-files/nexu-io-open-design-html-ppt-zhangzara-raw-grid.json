  \"file-write\",\n            \"live-artifact\"\n          ]\n        }\n      ]\n    },\n    \"capabilities\": [\n      \"prompt:inject\",\n      \"fs:write\"\n    ],\n    \"category\": \"design-craft\"\n  }\n}\n"
