      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Open Design — RAW GRID Neobrutalist Deck</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap');\n/* =============================================\n   RAW GRID — Neobrutalist Presentation Template\n   ============================================= */\n\n/* --- RESET & BASE --- */\n*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n:root {\n  --black: #0e0d0b;\n  --white: #f7f4ec;\n  --pink: #f2d4cf;\n  --green: #e5edd6;\n  --gray: #ece8db;\n  --darkgray: #3a382f;\n  --red: #c8371e;\n  --border: 3px solid var(--black);\n  --shadow: 6px 6px 0 var(--black);\n  --shadow-sm: 4px 4px 0 var(--black);\n  --font-sans: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  --font-mono: 'JetBrains Mono', 'SFMono-Regular', Menlo, monospace;\n}\nhtml, body {\n  width: 100%; height: 100%;\n  font-family: var(--font-sans);\n  background: var(--white);\n  color: var(--black);\n  overflow: hidden;\n}\n\n/* --- SLIDE SYSTEM --- */\n.slide-deck {\n  width: 100vw; height: 100vh;\n  position: relative;\n  overflow: hidden;\n}\n.slide {\n  position: absolute;\n  top: 0; left: 0;\n  width: 100%; height: 100%;\n  display: none;\n  background: var(--white);\n  overflow: hidden;\n}\n.slide.active { display: flex; }\n.slide-content {\n  width: 100%; height: 100%;\n  overflow: hidden;\n}\n.slide.active .slide-content {\n  animation: slide-in 0.5s cubic-bezier(.16,1,.3,1) both;\n}\n/* opacity-only child stagger: keeps the shared 3px grid borders aligned while panels land in sequence */\n.slide.active .slide-content > * {\n  animation: fade-in 0.45s cubic-bezier(.16,1,.3,1) both;\n}\n.slide.active .slide-content > *:nth-child(2) { animation-delay: 0.08s; }\n.slide.active .slide-content > *:nth-child(3) { animation-delay: 0.16s; }\n.slide.active .slide-content > *:nth-child(4) { animation-delay: 0.24s; }\n@keyframes slide-in {\n  from { opacity: 0; transform: translateY(14px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n@keyframes fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .slide.active .slide-content,\n  .slide.active .slide-content > * { animation: none; }\n  * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }\n}\n\n/* --- TYPOGRAPHY --- */\n.t-display {\n  font-size: clamp(48px, 7vw, 96px);\n  font-weight: 900;\n  line-height: 1.05;\n  letter-spacing: -0.02em;\n  text-transform: uppercase;\n}\n.t-headline {\n  font-size: clamp(32px, 4.5vw, 64px);\n  font-weight: 900;\n  line-height: 1.1;\n  letter-spacing: -0.01em;\n  text-transform: uppercase;\n}\n.t-title {\n  font-size: clamp(24px, 2.5vw, 36px);\n  font-weight: 800;\n  line-height: 1.2;\n  text-transform: uppercase;\n  letter-spacing: 0.01em;\n}\n.t-subtitle {\n  font-size: clamp(16px, 1.4vw, 22px);\n  font-weight: 700;\n  line-height: 1.3;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.t-body {\n  font-size: clamp(15px, 1.25vw, 19px);\n  font-weight: 500;\n  line-height: 1.55;\n  max-width: 60ch;\n}\n.t-caption {\n  font-family: var(--font-mono);\n  font-size: clamp(11px, 1vw, 13px);\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n.t-number {\n  font-size: clamp(64px, 8vw, 120px);\n  font-weight: 900;\n  line-height: 1;\n  letter-spacing: -0.04em;\n}\n\n/* --- UTILITIES --- */\n.b { border: var(--border); }\n.b-t { border-top: var(--border); }\n.b-b { border-bottom: var(--border); }\n.b-l { border-left: var(--border); }\n.b-r { border-right: var(--border); }\n.bg-pink { background: var(--pink); }\n.bg-green { background: var(--green); }\n.bg-red { background: var(--red); }\n.bg-black { background: var(--black); }\n.bg-gray { background: var(--gray); }\n.bg-white { background: var(--white); }\n.c-white { color: var(--white); }\n.c-black { color: var(--black); }\n.pad-lg { padding: clamp(32px, 4vw, 64px); }\n.pad-md { padding: clamp(20px, 2.5vw, 40px); }\n.pad-sm { padding: clamp(12px, 1.5vw, 20px); }\n.shadow { box-shadow: var(--shadow); }\n.shadow-sm { box-shadow: var(--shadow-sm); }\n.w-100 { width: 100%; }\n.h-100 { height: 100%; }\n.flex { display: flex; }\n.col { flex-direction: column; }\n.center { align-items: center; justify-content: center; }\n.grow { flex: 1; }\n.gap-sm { gap: clamp(8px, 1vw, 16px); }\n.gap-md { gap: clamp(16px, 2vw, 32px); }\n.gap-lg { gap: clamp(24px, 3vw, 48px); }\n.arrow::before { content: \"\\2192\\00a0\"; }\n.grid { display: grid; }\n\n/* --- SPECIAL COMPONENTS --- */\n.label {\n  display: inline-block;\n  background: var(--black);\n  color: var(--white);\n  padding: 6px 14px;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n.line {\n  width: 60px;\n  height: 4px;\n  background: var(--red);\n}\n.line-w { width: 100%; }\n.line-v {\n  width: 4px;\n  height: 60px;\n  background: var(--black);\n}\n\n/* =============================================\n   SLIDE 1 — TITLE / COVER\n   ============================================= */\n.s1 .slide-content {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  height: 100%;\n}\n.s1-left {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  padding: clamp(32px, 4vw, 64px);\n  background: var(--pink);\n  border-right: var(--border);\n}\n.s1-brand {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.s1-logo-box {\n  width: 48px; height: 48px;\n  border: var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 18px;\n  font-weight: 900;\n  background: var(--red);\n  color: var(--white);\n  box-shadow: var(--shadow-sm);\n}\n.s1-brand-text {\n  font-size: 20px;\n  font-weight: 900;\n  letter-spacing: -0.02em;\n}\n.s1-headline { margin-top: auto; margin-bottom: auto; }\n.s1-cta .label { cursor: pointer; }\n.s1-right {\n  display: flex;\n  flex-direction: column;\n}\n.s1-list-item {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  padding: 0 clamp(24px, 3vw, 48px);\n  border-bottom: var(--border);\n  font-size: clamp(18px, 2vw, 28px);\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n  cursor: pointer;\n  transition: background 0.15s;\n}\n.s1-list-item:last-child { border-bottom: none; }\n.s1-list-item:hover { background: var(--green); }\n.s1-list-item::before {\n  content: \"\\2192\\00a0\";\n  margin-right: 12px;\n  font-size: 0.85em;\n}\n\n/* =============================================\n   SLIDE 2 — SPLIT FEATURE\n   ============================================= */\n.s2 .slide-content {\n  display: grid;\n  grid-template-columns: 45% 55%;\n  height: 100%;\n}\n.s2-left {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: clamp(32px, 4vw, 64px);\n  border-right: var(--border);\n}\n.s2-meta {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin-bottom: clamp(24px, 3vw, 48px);\n}\n.s2-right {\n  display: grid;\n  grid-template-rows: 1fr 1fr;\n}\n.s2-block {\n  padding: clamp(24px, 3vw, 48px);\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n.s2-block:first-child { border-bottom: var(--border); }\n\n/* =============================================\n   SLIDE 3 — DATA BAR CHART\n   ============================================= */\n.s3 .slide-content {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n.s3-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: clamp(20px, 2vw, 32px) clamp(32px, 4vw, 64px);\n  border-bottom: var(--border);\n}\n.s3-body {\n  flex: 1;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n}\n.s3-chart-area {\n  padding: clamp(24px, 3vw, 48px);\n  border-right: var(--border);\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n.s3-chart-title {\n  margin-bottom: 24px;\n}\n.s3-bar-group {\n  margin-bottom: 20px;\n}\n.s3-bar-label {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  margin-bottom: 6px;\n}\n.s3-bar-track {\n  width: 100%;\n  height: 32px;\n  border: var(--border);\n  background: var(--white);\n  position: relative;\n}\n.s3-bar-fill {\n  height: 100%;\n  display: flex;\n  align-items: center;\n  padding-left: 10px;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 700;\n  background: var(--black);\n  color: var(--white);\n  transition: width 0.8s cubic-bezier(.16,1,.3,1);\n}\n.s3-bar-fill.hot { background: var(--red); }\n.s3-insights {\n  padding: clamp(24px, 3vw, 48px);\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: clamp(16px, 2vw, 32px);\n}\n.s3-stat-box {\n  border: var(--border);\n  padding: clamp(16px, 2vw, 28px);\n  background: var(--white);\n  box-shadow: var(--shadow-sm);\n}\n.s3-stat-number {\n  font-size: clamp(36px, 4vw, 56px);\n  font-weight: 900;\n  line-height: 1;\n  margin-bottom: 8px;\n}\n.s3-stat-label {\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n/* =============================================\n   SLIDE 4 — 4-CARD GRID\n   ============================================= */\n.s4 .slide-content {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n.s4-header {\n  padding: clamp(20px, 2vw, 32px) clamp(32px, 4vw, 64px);\n  border-bottom: var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.s4-grid {\n  flex: 1;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  grid-template-rows: 1fr 1fr;\n}\n.s4-card {\n  padding: clamp(24px, 3vw, 48px);\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n.s4-card:nth-child(1) { border-right: var(--border); border-bottom: var(--border); background: var(--white); }\n.s4-card:nth-child(2) { border-bottom: var(--border); background: var(--green); }\n.s4-card:nth-child(3) { border-right: var(--border); background: var(--pink); }\n.s4-card:nth-child(4) { background: var(--gray); }\n.s4-card-top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n}\n.s4-num {\n  font-family: var(--font-mono);\n  font-size: clamp(40px, 5vw, 72px);\n  font-weight: 700;\n  line-height: 1;\n  color: var(--black);\n  -webkit-text-stroke: 2px var(--black);\n  -webkit-text-fill-color: transparent;\n}\n.s4-icon {\n  width: 48px; height: 48px;\n  border: var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 20px;\n  font-weight: 900;\n  background: var(--white);\n}\n\n/* =============================================\n   SLIDE 5 — FULL IMAGE + TEXT OVERLAY\n   ============================================= */\n.s5 .slide-content {\n  display: grid;\n  grid-template-columns: 55% 45%;\n  height: 100%;\n}\n.s5-image-area {\n  background: var(--black);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n  overflow: hidden;\n}\n.s5-image-placeholder {\n  width: 80%;\n  height: 70%;\n  border: 3px dashed var(--white);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--white);\n  font-family: var(--font-mono);\n  font-size: 13px;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  opacity: 0.75;\n}\n.s5-text-area {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: clamp(32px, 4vw, 64px);\n  background: var(--white);\n}\n.s5-badge {\n  align-self: flex-start;\n  margin-bottom: clamp(24px, 3vw, 40px);\n}\n\n/* =============================================\n   SLIDE 6 — TIMELINE / PROCESS\n   ============================================= */\n.s6 .slide-content {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n.s6-header {\n  padding: clamp(20px, 2vw, 32px) clamp(32px, 4vw, 64px);\n  border-bottom: var(--border);\n}\n.s6-body {\n  flex: 1;\n  display: flex;\n  /* full-bleed columns: the colored panels run edge to edge like every other slide */\n  padding: 0;\n}\n.s6-step {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: clamp(24px, 3vw, 48px) clamp(24px, 3vw, 48px);\n  position: relative;\n}\n.s6-step + .s6-step { border-left: var(--border); }\n.s6-step-num {\n  font-family: var(--font-mono);\n  font-size: clamp(48px, 6vw, 80px);\n  font-weight: 700;\n  line-height: 1;\n  margin-bottom: clamp(16px, 2vw, 28px);\n  -webkit-text-stroke: 2px var(--black);\n  -webkit-text-fill-color: transparent;\n}\n.s6-step-title { margin-bottom: 12px; }\n.s6-connector {\n  position: absolute;\n  top: calc(50% - 16px);\n  right: -18px;\n  width: 32px; height: 32px;\n  border: var(--border);\n  background: var(--red);\n  color: var(--white);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 16px;\n  font-weight: 900;\n  z-index: 10;\n}\n.s6-step:nth-child(3) { background: var(--green); }\n.s6-step:nth-child(4) { background: var(--pink); }\n\n/* =============================================\n   SLIDE 7 — PIE / DONUT CHART + METRICS\n   ============================================= */\n.s7 .slide-content {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  height: 100%;\n}\n.s7-left {\n  padding: clamp(32px, 4vw, 64px);\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  border-right: var(--border);\n}\n.s7-donut-container {\n  position: relative;\n  width: clamp(200px, 22vw, 320px);\n  height: clamp(200px, 22vw, 320px);\n  margin-bottom: clamp(24px, 3vw, 40px);\n}\n.s7-donut-center {\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  text-align: center;\n}\n.s7-donut-value {\n  font-size: clamp(32px, 4vw, 52px);\n  font-weight: 900;\n  line-height: 1;\n}\n.s7-donut-label {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  margin-top: 4px;\n}\n.s7-legend {\n  display: flex;\n  gap: 24px;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n.s7-legend-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.s7-legend-swatch {\n  width: 16px; height: 16px;\n  border: var(--border);\n}\n.s7-right {\n  display: flex;\n  flex-direction: column;\n}\n.s7-metric-row {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  padding: 0 clamp(32px, 4vw, 64px);\n  border-bottom: var(--border);\n}\n.s7-metric-row:last-child { border-bottom: none; }\n.s7-metric-num {\n  font-size: clamp(36px, 4vw, 56px);\n  font-weight: 900;\n  min-width: 120px;\n}\n.s7-metric-info { margin-left: clamp(16px, 2vw, 32px); }\n.s7-metric-title { margin-bottom: 4px; }\n\n/* =============================================\n   SLIDE 8 — STATEMENT / QUOTE\n   ============================================= */\n.s8 .slide-content {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n.s8-top {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: clamp(32px, 4vw, 64px);\n  background: var(--green);\n  border-bottom: var(--border);\n  position: relative;\n}\n.s8-quote-mark {\n  font-size: clamp(56px, 7vw, 96px);\n  font-weight: 900;\n  line-height: 0.6;\n  color: var(--red);\n  margin-bottom: clamp(16px, 2vw, 28px);\n}\n.s8-statement {\n  max-width: 900px;\n}\n.s8-bottom {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  height: 140px;\n}\n.s8-stat {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  border-right: var(--border);\n}\n.s8-stat:last-child { border-right: none; }\n.s8-stat-num {\n  font-size: clamp(24px, 2.5vw, 36px);\n  font-weight: 900;\n  margin-bottom: 4px;\n}\n.s8-stat:nth-child(1) { background: var(--white); }\n.s8-stat:nth-child(2) { background: var(--pink); }\n.s8-stat:nth-child(3) { background: var(--gray); }\n.s8-stat:nth-child(4) { background: var(--black); color: var(--white); }\n\n/* =============================================\n   SLIDE 9 — COMPARISON TABLE\n   ============================================= */\n.s9 .slide-content {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n.s9-header {\n  padding: clamp(20px, 2vw, 32px) clamp(32px, 4vw, 64px);\n  border-bottom: var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.s9-table-wrap {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: clamp(24px, 3vw, 48px) clamp(32px, 4vw, 64px);\n  overflow: auto;\n}\n.s9-table {\n  width: 100%;\n  border-collapse: collapse;\n}\n.s9-table th {\n  border: var(--border);\n  padding: clamp(12px, 1.5vw, 20px);\n  font-family: var(--font-mono);\n  font-size: clamp(12px, 1.1vw, 13px);\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  text-align: left;\n  background: var(--black);\n  color: var(--white);\n}\n.s9-table td:nth-child(3) { font-weight: 800; color: var(--red); }\n.s9-table td {\n  border: var(--border);\n  padding: clamp(12px, 1.5vw, 20px);\n  font-size: clamp(14px, 1.2vw, 17px);\n  font-weight: 600;\n}\n.s9-table tr:nth-child(even) td { background: var(--gray); }\n.s9-table tr:hover td { background: var(--green); }\n\n/* =============================================\n   SLIDE 10 — CLOSING / CTA\n   ============================================= */\n.s10 .slide-content {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  height: 100%;\n}\n.s10-left {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: clamp(32px, 4vw, 64px);\n  background: var(--pink);\n  border-right: var(--border);\n}\n.s10-left .label {\n  background: var(--red);\n  box-shadow: var(--shadow-sm);\n  align-self: flex-start;\n}\n.s10-right {\n  display: flex;\n  flex-direction: column;\n}\n.s10-r-top {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: clamp(32px, 4vw, 64px);\n  border-bottom: var(--border);\n}\n.s10-r-bottom {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  height: 100px;\n}\n.s10-rb-block {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 13px;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.s10-rb-block:first-child { border-right: var(--border); background: var(--green); }\n.s10-rb-block:last-child { background: var(--black); color: var(--white); }\n\n/* =============================================\n   PRINT\n   ============================================= */\n@media print {\n  /* print styles */\n  .slide { position: static; display: flex !important; page-break-after: always; }\n}\n</style>\n</head>\n<body>\n\n<div class=\"slide-deck\" id=\"deck\">\n\n<!-- ====== SLIDE 1: COVER ====== -->\n<div class=\"slide s1 active\">\n  <div class=\"slide-content\">\n    <div class=\"s1-left\">\n      <div class=\"s1-brand\">\n        <div class=\"s1-logo-box\">OD</div>\n        <span class=\"s1-brand-text\">OPEN DESIGN</span>\n      </div>\n      <div class=\"s1-headline\">\n        <div class=\"t-display\">Open.<br>Design.</div>\n      </div>\n      <div class=\"s1-cta\">\n        <span class=\"label arrow\">Apache-2.0 &middot; Runs Locally &middot; BYOK</span>\n      </div>\n    </div>\n    <div class=\"s1-right\">\n      <div class=\"s1-list-item\">Why Open</div>\n      <div class=\"s1-list-item\">By The Numbers</div>\n      <div class=\"s1-list-item\">Core Capabilities</div>\n      <div class=\"s1-list-item\">HyperFrames</div>\n      <div class=\"s1-list-item\">Workflow</div>\n      <div class=\"s1-list-item\">Open vs Closed</div>\n      <div class=\"s1-list-item\">Get Started</div>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 2: SPLIT FEATURE ====== -->\n<div class=\"slide s2\">\n  <div class=\"slide-content\">\n    <div class=\"s2-left\">\n      <div class=\"s2-meta\">\n        <div class=\"line\"></div>\n        <span class=\"t-caption\">Why Open Design</span>\n      </div>\n      <div class=\"t-headline\" style=\"margin-bottom: 24px;\">Frontier AI Design, Set Free</div>\n      <p class=\"t-body\" style=\"max-width: 420px;\">In April 2026, Claude Design proved an LLM can truly design — yet it is closed-source, paid, and cloud-only. Open Design brings the full product-design workflow to your own machine: open, local, and agent-driven.</p>\n    </div>\n    <div class=\"s2-right\">\n      <div class=\"s2-block\">\n        <span class=\"t-number\">60K+</span>\n        <span class=\"t-subtitle\" style=\"margin-top: 8px;\">GitHub Stars</span>\n        <p class=\"t-body\" style=\"margin-top: 12px; color: var(--darkgray);\">Open source under Apache-2.0 — fork, self-host, and use commercially.</p>\n      </div>\n      <div class=\"s2-block bg-green\">\n        <span class=\"t-number\">21</span>\n        <span class=\"t-subtitle\" style=\"margin-top: 8px;\">Coding Agents</span>\n        <p class=\"t-body\" style=\"margin-top: 12px; color: var(--darkgray);\">Claude Code, Codex, Cursor and more — auto-detected from PATH, zero config.</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 3: BAR CHART ====== -->\n<div class=\"slide s3\">\n  <div class=\"slide-content\">\n    <div class=\"s3-header\">\n      <span class=\"t-title\">By The Numbers</span>\n      <span class=\"label\">Apache-2.0 Open Source</span>\n    </div>\n    <div class=\"s3-body\">\n      <div class=\"s3-chart-area\">\n        <div class=\"t-subtitle s3-chart-title\">GitHub Stars by Quarter (K &middot; Demo Data)</div>\n        <div class=\"s3-bar-group\">\n          <div class=\"s3-bar-label\">Q1</div>\n          <div class=\"s3-bar-track\"><div class=\"s3-bar-fill\" style=\"width: 20%;\">12K</div></div>\n        </div>\n        <div class=\"s3-bar-group\">\n          <div class=\"s3-bar-label\">Q2</div>\n          <div class=\"s3-bar-track\"><div class=\"s3-bar-fill\" style=\"width: 42%;\">25K</div></div>\n        </div>\n        <div class=\"s3-bar-group\">\n          <div class=\"s3-bar-label\">Q3</div>\n          <div class=\"s3-bar-track\"><div class=\"s3-bar-fill\" style=\"width: 70%;\">42K</div></div>\n        </div>\n        <div class=\"s3-bar-group\">\n          <div class=\"s3-bar-label\">Q4</div>\n          <div class=\"s3-bar-track\"><div class=\"s3-bar-fill hot\" style=\"width: 91%;\">60K+</div></div>\n        </div>\n      </div>\n      <div class=\"s3-insights\">\n        <div class=\"s3-stat-box\">\n          <div class=\"s3-stat-number\">300+</div>\n          <div class=\"s3-stat-label\">Contributors</div>\n        </div>\n        <div class=\"s3-stat-box bg-green\">\n          <div class=\"s3-stat-number\">217+</div>\n          <div class=\"s3-stat-label\">Plugins in the Ecosystem</div>\n        </div>\n        <div class=\"s3-stat-box bg-pink\">\n          <div class=\"s3-stat-number\">129</div>\n          <div class=\"s3-stat-label\">Design Systems</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 4: 4-CARD GRID ====== -->\n<div class=\"slide s4\">\n  <div class=\"slide-content\">\n    <div class=\"s4-header\">\n      <span class=\"t-title\">Core Capabilities</span>\n      <span class=\"t-caption\">What Open Design Provides</span>\n    </div>\n    <div class=\"s4-grid\">\n      <div class=\"s4-card\">\n        <div class=\"s4-card-top\">\n          <span class=\"s4-num\">01</span>\n          <div class=\"s4-icon\">I</div>\n        </div>\n        <div>\n          <div class=\"t-subtitle\" style=\"margin-bottom: 10px;\">Desktop-Native</div>\n          <p class=\"t-body\">Design happens on the desktop. Local files, Figma exports, and code repos are directly readable.</p>\n        </div>\n      </div>\n      <div class=\"s4-card\">\n        <div class=\"s4-card-top\">\n          <span class=\"s4-num\">02</span>\n          <div class=\"s4-icon\">II</div>\n        </div>\n        <div>\n          <div class=\"t-subtitle\" style=\"margin-bottom: 10px;\">Plug In Agents</div>\n          <p class=\"t-body\">Claude Code, Codex, and Cursor are already powerful. Open Design wires them into a full design workflow.</p>\n        </div>\n      </div>\n      <div class=\"s4-card\">\n        <div class=\"s4-card-top\">\n          <span class=\"s4-num\">03</span>\n          <div class=\"s4-icon\">III</div>\n        </div>\n        <div>\n          <div class=\"t-subtitle\" style=\"margin-bottom: 10px;\">Design Memory</div>\n          <p class=\"t-body\">Every choice becomes design systems, preferences, and memory — the next generation lands closer to what you want.</p>\n        </div>\n      </div>\n      <div class=\"s4-card\">\n        <div class=\"s4-card-top\">\n          <span class=\"s4-num\">04</span>\n          <div class=\"s4-icon\">IV</div>\n        </div>\n        <div>\n          <div class=\"t-subtitle\" style=\"margin-bottom: 10px;\">Full-Stack BYOK</div>\n          <p class=\"t-body\">Bring your own keys for Anthropic, OpenAI, Azure, and Google, plus 14 media providers.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 5: IMAGE + TEXT ====== -->\n<div class=\"slide s5\">\n  <div class=\"slide-content\">\n    <div class=\"s5-image-area\">\n      <div class=\"s5-image-placeholder\">[ Image Placeholder ]</div>\n    </div>\n    <div class=\"s5-text-area\">\n      <div class=\"label s5-badge\">Featured</div>\n      <div class=\"t-headline\" style=\"margin-bottom: 20px;\">HyperFrames</div>\n      <p class=\"t-body\" style=\"margin-bottom: 20px;\">Turn any design artifact into video. HyperFrames renders HTML compositions straight to MP4 — marketing shorts, product demos, and cinematic generative footage.</p>\n      <p class=\"t-body\" style=\"color: var(--darkgray); margin-bottom: 32px;\">The same artifact flows from sandbox preview to finished video — programmatic, repeatable, and entirely on your own machine.</p>\n      <div class=\"line\"></div>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 6: TIMELINE ====== -->\n<div class=\"slide s6\">\n  <div class=\"slide-content\">\n    <div class=\"s6-header\">\n      <div class=\"t-title\">From Idea to Delivery</div>\n    </div>\n    <div class=\"s6-body\">\n      <div class=\"s6-step\">\n        <span class=\"s6-step-num\">01</span>\n        <div class=\"s6-connector\">&rarr;</div>\n        <div class=\"t-subtitle s6-step-title\">Start</div>\n        <p class=\"t-body\">Describe your goal in one sentence, or pick a starting point from a template or plugin.</p>\n      </div>\n      <div class=\"s6-step\">\n        <span class=\"s6-step-num\">02</span>\n        <div class=\"s6-connector\">&rarr;</div>\n        <div class=\"t-subtitle s6-step-title\">Direct</div>\n        <p class=\"t-body\">Set the visual direction — palette, type, and spacing flow into generation automatically.</p>\n      </div>\n      <div class=\"s6-step\">\n        <span class=\"s6-step-num\">03</span>\n        <div class=\"s6-connector\">&rarr;</div>\n        <div class=\"t-subtitle s6-step-title\">Generate</div>\n        <p class=\"t-body\">The agent reads full context and produces real runnable files, previewed in a sandbox.</p>\n      </div>\n      <div class=\"s6-step\">\n        <span class=\"s6-step-num\">04</span>\n        <div class=\"t-subtitle s6-step-title\">Ship</div>\n        <p class=\"t-body\">Hand off to engineering or film it with HyperFrames. Every choice becomes context for the next run.</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 7: DONUT CHART + METRICS ====== -->\n<div class=\"slide s7\">\n  <div class=\"slide-content\">\n    <div class=\"s7-left\">\n      <div class=\"s7-donut-container\">\n        <svg viewBox=\"0 0 200 200\" width=\"100%\" height=\"100%\">\n          <circle cx=\"100\" cy=\"100\" r=\"80\" fill=\"none\" stroke=\"#c8371e\" stroke-width=\"24\" stroke-dasharray=\"314 502\" stroke-dashoffset=\"0\" transform=\"rotate(-90 100 100)\"/>\n          <circle cx=\"100\" cy=\"100\" r=\"80\" fill=\"none\" stroke=\"#f2d4cf\" stroke-width=\"24\" stroke-dasharray=\"126 502\" stroke-dashoffset=\"-314\" transform=\"rotate(-90 100 100)\"/>\n          <circle cx=\"100\" cy=\"100\" r=\"80\" fill=\"none\" stroke=\"#e5edd6\" stroke-width=\"24\" stroke-dasharray=\"50 502\" stroke-dashoffset=\"-440\" transform=\"rotate(-90 100 100)\"/>\n          <circle cx=\"100\" cy=\"100\" r=\"92\" fill=\"none\" stroke=\"#0e0d0b\" stroke-width=\"2\"/>\n          <circle cx=\"100\" cy=\"100\" r=\"68\" fill=\"none\" stroke=\"#0e0d0b\" stroke-width=\"2\"/>\n        </svg>\n        <div class=\"s7-donut-center\">\n          <div class=\"s7-donut-value\">217+</div>\n          <div class=\"s7-donut-label\">Plugins</div>\n        </div>\n      </div>\n      <div class=\"s7-legend\">\n        <div class=\"s7-legend-item\"><div class=\"s7-legend-swatch bg-red\"></div>Slides &amp; Decks</div>\n        <div class=\"s7-legend-item\"><div class=\"s7-legend-swatch bg-pink\"></div>Prototypes</div>\n        <div class=\"s7-legend-item\"><div class=\"s7-legend-swatch bg-green\"></div>Video &amp; More</div>\n      </div>\n    </div>\n    <div class=\"s7-right\">\n      <div class=\"s7-metric-row\">\n        <div class=\"s7-metric-num\">129</div>\n        <div class=\"s7-metric-info\">\n          <div class=\"t-subtitle s7-metric-title\">Design Systems</div>\n          <p class=\"t-caption\">Import from GitHub, Figma, or local files</p>\n        </div>\n      </div>\n      <div class=\"s7-metric-row bg-green\">\n        <div class=\"s7-metric-num\">21</div>\n        <div class=\"s7-metric-info\">\n          <div class=\"t-subtitle s7-metric-title\">Coding Agents</div>\n          <p class=\"t-caption\">Auto-detected from PATH, zero config</p>\n        </div>\n      </div>\n      <div class=\"s7-metric-row\">\n        <div class=\"s7-metric-num\">300+</div>\n        <div class=\"s7-metric-info\">\n          <div class=\"t-subtitle s7-metric-title\">Contributors</div>\n          <p class=\"t-caption\">Builders behind the open-source project</p>\n        </div>\n      </div>\n      <div class=\"s7-metric-row bg-pink\">\n        <div class=\"s7-metric-num\">-80%</div>\n        <div class=\"s7-metric-info\">\n          <div class=\"t-subtitle s7-metric-title\">Monthly Cost</div>\n          <p class=\"t-caption\">From $500 to ~$73 vs. Claude Design</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 8: STATEMENT / QUOTE ====== -->\n<div class=\"slide s8\">\n  <div class=\"slide-content\">\n    <div class=\"s8-top\">\n      <div class=\"s8-quote-mark\">\"</div>\n      <div class=\"s8-statement\">\n        <div class=\"t-headline\" style=\"margin-bottom: 24px;\">File-system semantics plus git-diffable artifacts — design is finally under version control.</div>\n        <div class=\"line\"></div>\n      </div>\n    </div>\n    <div class=\"s8-bottom\">\n      <div class=\"s8-stat\">\n        <span class=\"s8-stat-num\">60K+</span>\n        <span class=\"t-caption\">GitHub Stars</span>\n      </div>\n      <div class=\"s8-stat\">\n        <span class=\"s8-stat-num\">300+</span>\n        <span class=\"t-caption\">Contributors</span>\n      </div>\n      <div class=\"s8-stat\">\n        <span class=\"s8-stat-num\">217+</span>\n        <span class=\"t-caption\">Plugins</span>\n      </div>\n      <div class=\"s8-stat\">\n        <span class=\"s8-stat-num\">21</span>\n        <span class=\"t-caption\">Coding Agents</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 9: COMPARISON TABLE ====== -->\n<div class=\"slide s9\">\n  <div class=\"slide-content\">\n    <div class=\"s9-header\">\n      <span class=\"t-title\">Open vs Closed</span>\n      <span class=\"label\">Why Open Design</span>\n    </div>\n    <div class=\"s9-table-wrap\">\n      <table class=\"s9-table\">\n        <thead>\n          <tr>\n            <th>Capability</th>\n            <th>Claude Design</th>\n            <th>Open Design</th>\n            <th>Why It Matters</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>Source</td>\n            <td>Closed</td>\n            <td>Apache-2.0 Open</td>\n            <td>Fork, self-host, commercial use</td>\n          </tr>\n          <tr>\n            <td>Where It Runs</td>\n            <td>Cloud Only</td>\n            <td>Your Own Machine</td>\n            <td>Local files &amp; repos readable</td>\n          </tr>\n          <tr>\n            <td>Model Choice</td>\n            <td>Locked to One</td>\n            <td>Full-Stack BYOK</td>\n            <td>Anthropic, OpenAI, Azure, Google</td>\n          </tr>\n          <tr>\n            <td>Agents</td>\n            <td>Built-In Only</td>\n            <td>21 Coding Agents</td>\n            <td>Auto-detected, zero config</td>\n          </tr>\n          <tr>\n            <td>Monthly Cost</td>\n            <td>~$500</td>\n            <td>~$73</td>\n            <td>Over 80% less</td>\n          </tr>\n          <tr>\n            <td>Sign-Up</td>\n            <td>Required</td>\n            <td>None</td>\n            <td>Your keys never leave your machine</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>\n\n<!-- ====== SLIDE 10: CLOSING / CTA ====== -->\n<div class=\"slide s10\">\n  <div class=\"slide-content\">\n    <div class=\"s10-left\">\n      <div class=\"t-display\" style=\"margin-bottom: 24px;\">Open.<br>Local.</div>\n      <p class=\"t-body\" style=\"margin-bottom: 32px; max-width: 380px;\">Frontier AI design, back on every creator's desk. Download Open Design and run the full workflow on your own machine.</p>\n      <a class=\"label arrow\" href=\"https://open-design.ai/\" target=\"_blank\" rel=\"noreferrer noopener\" style=\"text-decoration:none;\">Download Open Design</a>\n    </div>\n    <div class=\"s10-right\">\n      <div class=\"s10-r-top\">\n        <div class=\"t-title\" style=\"margin-bottom: 20px;\">Get Connected</div>\n        <p class=\"t-body\" style=\"margin-bottom: 8px;\"><strong>GitHub:</strong> github.com/nexu-io/open-design</p>\n        <p class=\"t-body\" style=\"margin-bottom: 8px;\"><strong>Discord:</strong> discord.gg/mHAjSMV6gz</p>\n        <p class=\"t-body\" style=\"margin-bottom: 8px;\"><strong>X:</strong> x.com/nexudotio</p>\n        <p class=\"t-body\"><strong>License:</strong> Apache-2.0 — free forever</p>\n      </div>\n      <div class=\"s10-r-bottom\">\n        <a class=\"s10-rb-block\" href=\"https://open-design.ai/\" target=\"_blank\" rel=\"noreferrer noopener\" style=\"text-decoration:none;color:inherit;\">macOS / Windows</a>\n        <a class=\"s10-rb-block\" href=\"https://github.com/nexu-io/open-design\" target=\"_blank\" rel=\"noreferrer noopener\" style=\"text-decoration:none;color:inherit;\">Star on GitHub</a>\n      </div>\n    </div>\n  </div>\n</div>\n\n</div><!-- /slide-deck -->\n\n<script>\nconst slides = document.querySelectorAll('.slide');\nlet current = 0;\nconst total = slides.length;\n\nfunction showSlide(idx) {\n  slides[current].classList.remove('active');\n  current = Math.max(0, Math.min(idx, total - 1));\n  slides[current].classList.add('active');\n  /* slide change handler */\n}\nfunction nextSlide() { showSlide(current + 1); }\nfunction prevSlide() { showSlide(current - 1); }\nfunction firstSlide() { showSlide(0); }\nfunction lastSlide() { showSlide(total - 1); }\n\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); nextSlide(); }\n  else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); prevSlide(); }\n  else if (e.key === 'Home') { e.preventDefault(); firstSlide(); }\n  else if (e.key === 'End') { e.preventDefault(); lastSlide(); }\n});\n\nlet touchStartY = 0;\ndocument.addEventListener('touchstart', e => { touchStartY = e.changedTouches[0].screenY; });\ndocument.addEventListener('touchend', e => {\n  const touchEndY = e.changedTouches[0].screenY;\n  if (touchStartY - touchEndY > 50) nextSlide();\n  else if (touchEndY - touchStartY > 50) prevSlide();\n});\n</script>\n</body>\n</html>\n"
    },
    {
      "path": "open-design.json",
      "encoding": "utf8",
      "content": "{\n  \"$schema\": \"https://open-design.ai/schemas/plugin.v1.json\",\n  \"specVersion\": \"1.0.0\",\n  \"name\": \"example-html-ppt-zhangzara-raw-grid\",\n  \"title\": \"Html Ppt Zhangzara Raw Grid\",\n  \"title_i18n\": {\n    \"zh-CN\": \"Html Ppt Zhangzara Raw Grid\",\n    \"zh-TW\": \"Html Ppt Zhangzara Raw Grid\",\n    \"ja\": \"Html Ppt Zhangzara Raw Grid\",\n    \"ko\": \"Html Ppt Zhangzara Raw Grid\",\n    \"de\": \"Html Ppt Zhangzara Raw Grid\",\n    \"fr\": \"Html Ppt Zhangzara Raw Grid\",\n    \"ru\": \"Html Ppt Zhangzara Raw Grid\",\n    \"es\": \"Html Ppt Zhangzara Raw Grid\",\n    \"pt-BR\": \"Html Ppt Zhangzara Raw Grid\",\n    \"it\": \"Html Ppt Zhangzara Raw Grid\",\n    \"vi\": \"Html Ppt Zhangzara Raw Grid\",\n    \"pl\": \"Html Ppt Zhangzara Raw Grid\",\n    \"id\": \"Html Ppt Zhangzara Raw Grid\",\n    \"nl\": \"Html Ppt Zhangzara Raw Grid\",\n    \"ar\": \"Html Ppt Zhangzara Raw Grid\",\n    \"tr\": \"Html Ppt Zhangzara Raw Grid\",\n    \"uk\": \"Html Ppt Zhangzara Raw Grid\",\n    \"en\": \"Html Ppt Zhangzara Raw Grid\"\n  },\n  \"version\": \"0.1.0\",\n  \"description\": \"Raw Grid — Neo-brutalist deck with thick borders, offset shadows, and a pink/sage/ink palette. Anything that should feel direct and graphic-confident: founder pitches, accelerator demos, brand decks, indie launches, creator portfolios.\",\n  \"description_i18n\": {\n    \"zh-CN\": \"Raw Grid——新粗野主义演示模板，采用粗边框、偏移阴影和粉/鼠尾草/墨色配色方案。适合需要直接且富有图形自信感的场景：创始人路演、加速器演示、品牌手册、独立产品发布、创作者作品集。\",\n    \"zh-TW\": \"Raw Grid——新粗野主義簡報模板，採用粗邊框、偏移陰影和粉紅/鼠尾草綠/墨色配色方案。適合需要直接且富有圖形自信感的場景：創辦人募資簡報、加速器展示、品牌手冊、獨立產品發布、創作者作品集。\",\n    \"ja\": \"Raw Grid — 太い境界線、オフセットシャドウ、ピンク/セージ/インクのパレットを備えたネオブルータリストデッキ。直接的でグラフィカルな自信を表現したいシーンに最適：創業者ピッチ、アクセラレーターデモ、ブランドデッキ、インディーローンチ、クリエイターポートフォリオ。\",\n    \"ko\": \"Raw Grid — 두꺼운 테두리, 오프셋 그림자, 핑크/세이지/잉크 팔레트를 갖춘 네오 브루탈리스트 덱. 직접적이고 그래픽적으로 자신감 있는 느낌이 필요한 곳에 적합: 창업자 피칭, 액셀러레이터 데모, 브랜드 덱, 인디 론칭, 크리에이터 포트폴리오.\",\n    \"de\": \"Raw Grid — Neo-brutalistisches Deck mit dicken Rahmen, versetzten Schatten und einer Pink/Salbei/Tinte-Palette. Für alles, was direkt und grafisch-selbstbewusst wirken soll: Gründer-Pitches, Accelerator-Demos, Brand-Decks, Indie-Launches, Creator-Portfolios.\",\n    \"fr\": \"Raw Grid — Deck néo-brutaliste avec bordures épaisses, ombres décalées et palette rose/sauge/encre. Pour tout ce qui doit être direct et graphiquement confiant : pitchs de fondateurs, démos d'accélérateurs, decks de marque, lancements indés, portfolios de créateurs.\",\n    \"ru\": \"Raw Grid — необруталистская презентация с толстыми границами, смещёнными тенями и палитрой розового/шалфея/чернил. Для всего, что должно выглядеть прямолинейно и графически уверенно: питчи основателей, демо для акселераторов, брендовые презентации, инди-запуски, портфолио криейторов.\",\n    \"es\": \"Raw Grid — Presentación neobrutalista con bordes gruesos, sombras desplazadas y paleta rosa/salvia/tinta. Para todo lo que deba sentirse directo y gráficamente confiado: pitches de fundadores, demos de aceleradoras, decks de marca, lanzamientos indie, portafolios de creadores.\",\n    \"pt-BR\": \"Raw Grid — Deck neo-brutalista com bordas grossas, sombras deslocadas e paleta rosa/sálvia/tinta. Para tudo que precisa parecer direto e graficamente confiante: pitches de fundadores, demos de aceleradoras, decks de marca, lançamentos indie, portfólios de criadores.\",\n    \"it\": \"Raw Grid — Deck neo-brutalista con bordi spessi, ombre sfalsate e palette rosa/salvia/inchiostro. Per tutto ciò che deve risultare diretto e graficamente sicuro: pitch di fondatori, demo per acceleratori, deck di brand, lanci indie, portfolio di creator.\",\n    \"vi\": \"Raw Grid — Bộ slide neo-brutalist với viền dày, đổ bóng lệch và bảng màu hồng/xanh xám/mực. Dành cho mọi thứ cần cảm giác trực tiếp và tự tin về đồ họa: bài thuyết trình nhà sáng lập, demo tăng tốc, bộ tài liệu thương hiệu, ra mắt indie, portfolio sáng tạo.\",\n    \"pl\": \"Raw Grid — Neo-brutalistyczna prezentacja z grubymi obramowaniami, przesuniętymi cieniami i paletą różu/szałwii/atramentu. Do wszystkiego, co ma być bezpośrednie i graficznie pewne siebie: pitche założycieli, dema dla akceleratorów, decki brandowe, indie launcze, portfolio twórców.\",\n    \"id\": \"Raw Grid — Deck neo-brutalis dengan border tebal, bayangan offset, dan palet pink/sage/tinta. Untuk apa pun yang harus terasa langsung dan percaya diri secara grafis: pitch founder, demo akselerator, deck brand, peluncuran indie, portofolio kreator.\",\n    \"nl\": \"Raw Grid — Neo-brutalistische deck met dikke randen, verschoven schaduwen en een roze/salie/inkt-palet. Voor alles dat direct en grafisch zelfverzekerd moet aanvoelen: founder-pitches, accelerator-demo's, brand-decks, indie-launches, creator-portfolio's.\",\n    \"ar\": \"Raw Grid — عرض تقديمي بأسلوب نيو-بروتاليست مع حدود سميكة وظلال منحرفة ولوحة ألوان وردي/ميرمية/حبر. لكل ما يجب أن يبدو مباشراً وواثقاً بصرياً: عروض المؤسسين، عروض المسرّعات، عروض العلامات التجارية، الإطلاقات المستقلة، ملفات أعمال المبدعين.\",\n    \"tr\": \"Raw Grid — Kalın kenarlıklar, kaydırılmış gölgeler ve pembe/adaçayı/mürekkep paletine sahip neo-brütalist sunum. Doğrudan ve grafik olarak kendinden emin hissettirmesi gereken her şey için: kurucu sunumları, hızlandırıcı demoları, marka sunumları, bağımsız lansmanlar, yaratıcı portföyleri.\",\n    \"uk\": \"Raw Grid — необруталістська презентація з товстими межами, зміщеними тінями та палітрою рожевого/шавлії/чорнила. Для всього, що має виглядати прямолінійно та графічно впевнено: пітчі засновників, демо для акселераторів, брендові презентації, інді-запуски, портфоліо криейторів.\",\n    \"en\": \"Raw Grid — Neo-brutalist deck with thick borders, offset shadows, and a pink/sage/ink palette. Anything that should feel direct and graphic-confident: founder pitches, accelerator demos, brand decks, indie launches, creator portfolios.\"\n  },\n  \"license\": \"MIT\",\n  \"author\": {\n    \"name\": \"Open Design\",\n    \"url\": \"https://github.com/nexu-io\"\n  },\n  \"homepage\": \"https://github.com/nexu-io/open-design/tree/main/plugins/_official/examples/html-ppt-zhangzara-raw-grid\",\n  \"tags\": [\n    \"example\",\n    \"first-party\",\n    \"deck\",\n    \"marketing\",\n    \"web\",\n    \"raw-grid\",\n    \"zhangzara-raw-grid\",\n    \"raw\",\n    \"punchy\",\n    \"direct\",\n    \"modern\",\n    \"startup-pitch\",\n    \"accelerator-demo-day\",\n    \"html-deck\",\n    \"html-slides\",\n    \"zhangzara\"\n  ],\n  \"compat\": {\n    \"agentSkills\": [\n      {\n        \"path\": \"./SKILL.md\"\n      }\n    ]\n  },\n  \"od\": {\n    \"kind\": \"scenario\",\n    \"taskKind\": \"new-generation\",\n    \"mode\": \"deck\",\n    \"scenario\": \"marketing\",\n    \"surface\": \"web\",\n    \"preview\": {\n      \"type\": \"html\",\n      \"entry\": \"./example.html\"\n    },\n    \"useCase\": {\n      \"query\": {\n        \"en\": \"Raw Grid — Neo-brutalist deck with thick borders, offset shadows, and a pink/sage/ink palette. Anything that should feel direct and graphic-confident: founder pitches, accelerator demos, brand decks, indie launches, creator portfolios.\",\n        \"zh-CN\": \"使用这个插件完成以下任务：Raw Grid — Neo-brutalist deck with thick borders, offset shadows, and a pink/sage/ink palette. Anything that should feel direct and graphic-confident: founder pitches, accelerator demos, brand decks, indie launches, creator portfolios.\"\n      },\n      \"exampleOutputs\": [\n        {\n          \"path\": \"./example.html\",\n          \"title\": \"Html Ppt Zhangzara Raw Grid\"\n        }\n      ]\n    },\n    \"context\": {\n      \"skills\": [\n        {\n          \"path\": \"./SKILL.md\"\n        }\n      ],\n      \"assets\": [\n        \"./example.html\"\n      ]\n    },\n    \"pipeline\": {\n      \"stages\": [\n        {\n          \"id\": \"generate\",\n          \"atoms\": [\n            \"file-write\",\n            \"live-artifact\"\n          ]\n        }\n      ]\n    },\n    \"capabilities\": [\n      \"prompt:inject\",\n      \"fs:write\"\n    ]\n  }\n}\n"
    }
