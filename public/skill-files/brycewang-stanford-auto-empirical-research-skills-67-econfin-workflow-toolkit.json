cago\"},\n    {\"name\": \"Journal of Law, Economics and Organization\", \"abbr\": \"JLEO\", \"category\": \"ECO\", \"rank\": \"B+\", \"issn\": \"1465-7341\", \"rss_url\": \"https://academic.oup.com/jleo/rss\", \"web_url\": null, \"publisher\": \"OUP\"},\n    {\"name\": \"Journal of Public Economics\", \"abbr\": \"JPubE\", \"category\": \"ECO\", \"rank\": \"B+\", \"issn\": \"0047-2727\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/00472727\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of Urban Economics\", \"abbr\": \"JUE\", \"category\": \"ECO\", \"rank\": \"B+\", \"issn\": \"0094-1190\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/00941190\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Review of International Political Economy\", \"abbr\": \"RIPE\", \"category\": \"ECO\", \"rank\": \"B+\", \"issn\": \"1466-4526\", \"rss_url\": null, \"web_url\": \"https://www.tandfonline.com/toc/rrip20/current\", \"publisher\": \"Taylor&Francis\"},\n    {\"name\": \"World Development\", \"abbr\": \"WD\", \"category\": \"ECO\", \"rank\": \"B+\", \"issn\": \"0305-750X\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/0305750X\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of Finance\", \"abbr\": \"JF\", \"category\": \"FIN\", \"rank\": \"A+\", \"issn\": \"1540-6261\", \"rss_url\": \"https://onlinelibrary.wiley.com/feed/15406261/most-recent\", \"web_url\": null, \"publisher\": \"Wiley\"},\n    {\"name\": \"Journal of Financial Economics\", \"abbr\": \"JFE\", \"category\": \"FIN\", \"rank\": \"A+\", \"issn\": \"0304-405X\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/0304405X\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Review of Financial Studies\", \"abbr\": \"RFS\", \"category\": \"FIN\", \"rank\": \"A+\", \"issn\": \"1465-7368\", \"rss_url\": \"https://academic.oup.com/rss/site_5511/3372.xml\", \"web_url\": \"https://academic.oup.com/rfs/issue\", \"publisher\": \"OUP\"},\n    {\"name\": \"Journal of Financial and Quantitative Analysis\", \"abbr\": \"JFQA\", \"category\": \"FIN\", \"rank\": \"A\", \"issn\": \"1756-6916\", \"rss_url\": null, \"web_url\": \"https://www.cambridge.org/core/journals/journal-of-financial-and-quantitative-analysis/latest-issue\", \"publisher\": \"Cambridge\"},\n    {\"name\": \"Management Science\", \"abbr\": \"MS\", \"category\": \"FIN\", \"rank\": \"A\", \"issn\": \"1526-5501\", \"rss_url\": \"https://pubsonline.informs.org/action/showFeed?type=etoc&feed=rss&jc=mnsc\", \"web_url\": null, \"publisher\": \"INFORMS\"},\n    {\"name\": \"Journal of International Business Studies\", \"abbr\": \"JIBS\", \"category\": \"FIN\", \"rank\": \"A-\", \"issn\": \"1478-6990\", \"rss_url\": null, \"web_url\": null, \"publisher\": \"Springer\"},\n    {\"name\": \"Review of Finance\", \"abbr\": \"RoF\", \"category\": \"FIN\", \"rank\": \"A-\", \"issn\": \"1573-692X\", \"rss_url\": \"https://academic.oup.com/rof/rss\", \"web_url\": \"https://academic.oup.com/rof/issue\", \"publisher\": \"OUP\"},\n    {\"name\": \"Journal of Corporate Finance\", \"abbr\": \"JCF\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"0929-1199\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/09291199\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of Financial Intermediation\", \"abbr\": \"JFI\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"1042-9573\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/10429573\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of Banking and Finance\", \"abbr\": \"JBF\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"0378-4266\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/03784266\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of International Money and Finance\", \"abbr\": \"JIMF\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"0261-5606\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/02615606\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Financial Management\", \"abbr\": \"FM\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"1755-053X\", \"rss_url\": \"https://onlinelibrary.wiley.com/feed/1755053x/most-recent\", \"web_url\": null, \"publisher\": \"Wiley\"},\n    {\"name\": \"Journal of Empirical Finance\", \"abbr\": \"JEmpFin\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"0927-5398\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/09275398\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of Financial Markets\", \"abbr\": \"JFM\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"1386-4181\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/13864181\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of Financial Stability\", \"abbr\": \"JFS\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"1572-3089\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/15723089\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of Real Estate Finance and Economics\", \"abbr\": \"JREFE\", \"category\": \"FIN\", \"rank\": \"B+\", \"issn\": \"1573-045X\", \"rss_url\": null, \"web_url\": null, \"publisher\": \"Springer\"},\n    {\"name\": \"Accounting Review\", \"abbr\": \"TAR\", \"category\": \"ACCO\", \"rank\": \"A\", \"issn\": \"1558-7967\", \"rss_url\": null, \"web_url\": \"https://publications.aaahq.org/accounting-review/issue\", \"publisher\": \"AAA\"},\n    {\"name\": \"Journal of Accounting and Economics\", \"abbr\": \"JAE\", \"category\": \"ACCO\", \"rank\": \"A\", \"issn\": \"0165-4101\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/01654101\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Journal of Accounting Research\", \"abbr\": \"JAR\", \"category\": \"ACCO\", \"rank\": \"A\", \"issn\": \"1475-679X\", \"rss_url\": \"https://onlinelibrary.wiley.com/feed/1475679x/most-recent\", \"web_url\": null, \"publisher\": \"Wiley\"},\n    {\"name\": \"Accounting, Organizations and Society\", \"abbr\": \"AOS\", \"category\": \"ACCO\", \"rank\": \"A\", \"issn\": \"0361-3682\", \"rss_url\": \"https://rss.sciencedirect.com/publication/science/03613682\", \"web_url\": null, \"publisher\": \"Elsevier\"},\n    {\"name\": \"Review of Accounting Studies\", \"abbr\": \"RAST\", \"category\": \"ACCO\", \"rank\": \"A-\", \"issn\": \"1573-7136\", \"rss_url\": null, \"web_url\": null, \"publisher\": \"Springer\"},\n    {\"name\": \"Contemporary Accounting Research\", \"abbr\": \"CAR\", \"category\": \"ACCO\", \"rank\": \"A-\", \"issn\": \"1911-3846\", \"rss_url\": \"https://onlinelibrary.wiley.com/feed/19113846/most-recent\", \"web_url\": null, \"publisher\": \"Wiley\"}\n  ]\n}\n"
