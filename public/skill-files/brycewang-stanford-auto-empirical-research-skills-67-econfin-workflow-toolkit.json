      "content": "% !TEX program = xelatex\n% ============================================================\n%  Chinese Academic Beamer · CUFE School-of-Finance Style\n%  Overleaf 编译说明：\n%    1. 上传本 .tex + figures/ 整个文件夹\n%    2. Settings → Compiler → XeLaTeX\n%    3. Recompile 两次（让目录页对齐）\n% ============================================================\n\\documentclass[10pt,aspectratio=169]{beamer}\n\n% ---- 中文支持（fandol，免系统字体） --------------------------\n\\usepackage[UTF8,fontset=fandol]{ctex}\n\n% ---- 主题：空主题 + 自建 CUFE 模板 ---------------------------\n\\usetheme{default}\n\\useinnertheme{circles}\n\n% ---- 常用宏包 ------------------------------------------------\n\\usepackage{booktabs}\n\\usepackage{array}\n\\usepackage{graphicx}\n\\usepackage{amsmath}\n\\usepackage{amssymb}\n\\usepackage{makecell}\n\\usepackage{xcolor}\n\\usepackage{tikz}\n\\usetikzlibrary{arrows.meta,positioning,fit,calc}\n\n% ---- 色板（锁定） --------------------------------------------\n\\definecolor{cufenavy}{HTML}{1F3A60}   % 深蓝（顶部色带、结构色）\n\\definecolor{cufetext}{HTML}{2A2A2A}   % 帧标题 / 正文深色（不用蓝）\n\\definecolor{cuferule}{HTML}{7F8FAA}   % 页脚细分隔线\n\n\\setbeamercolor{structure}{fg=cufenavy}\n\\setbeamercolor{normal text}{fg=cufetext}\n\\setbeamercolor{alerted text}{fg=cufenavy}\n\\setbeamercolor{title}{fg=cufenavy}\n\\setbeamercolor{subtitle}{fg=cufenavy}\n\\setbeamercolor{frametitle}{fg=cufetext,bg=}\n\\setbeamercolor{item}{fg=cufenavy}\n\\setbeamercolor{block title}{fg=white,bg=cufenavy}\n\\setbeamercolor{block body}{fg=cufetext,bg=cufenavy!8}\n\n% ---- 背景：顶部深蓝细条 + 右上 Logo（y = -0.70cm 为中心线）------\n\\setbeamertemplate{background}{%\n  \\begin{tikzpicture}[overlay,remember picture]\n    \\fill[cufenavy]\n      (current page.north west) rectangle\n      ([yshift=-0.15cm]current page.north east);\n    \\node[anchor=east,inner sep=0pt]\n      at ([xshift=-0.45cm,yshift=-0.70cm]current page.north east)\n      {\\includegraphics[height=0.70cm,keepaspectratio]{figures/logo_cufe_small.png}};\n    \\draw[cuferule,line width=0.3pt]\n      ([yshift=0.70cm]current page.south west) --\n      ([yshift=0.70cm]current page.south east);\n  \\end{tikzpicture}%\n}\n\n% ---- 帧标题：TikZ 绝对定位，中心 y=-0.70cm 与 Logo 对齐 ---------\n\\setbeamertemplate{frametitle}{%\n  \\begin{tikzpicture}[overlay,remember picture]\n    \\node[anchor=north west,inner sep=0pt,\n          text width=\\dimexpr\\paperwidth-5.0cm\\relax,\n          align=left]\n      at ([xshift=0.40cm,yshift=-0.50cm]current page.north west)\n      {\\color{cufetext}\\bfseries\\large\\insertframetitle};\n  \\end{tikzpicture}%\n  \\vspace*{0.55cm}%\n}\n\\setbeamerfont{frametitle}{size=\\large,series=\\bfseries}\n\n% ---- 页脚：章节名（左）+ 页码（右） -----------------------------\n\\setbeamertemplate{footline}{%\n  \\leavevmode%\n  \\hbox to \\paperwidth{%\n    \\hspace*{0.55cm}%\n    \\begin{minipage}[b]{\\dimexpr\\paperwidth-2.8cm\\relax}\\vspace{0pt}%\n      {\\color{cufenavy}\\footnotesize\\insertsectionhead}%\n    \\end{minipage}%\n    \\hfill\n    \\begin{minipage}[b]{1.8cm}\\vspace{0pt}%\n      \\raggedleft{\\color{cufenavy}\\footnotesize%\n        % 只显示当前帧号：\\inserttotalframenumber 在 ctex + beamer 下\n        % 偶发返回诡异值（\"80\" 等），直接放弃 \"X / N\" 格式更稳\n        \\insertframenumber}%\n    \\end{minipage}%\n    \\hspace*{0.55cm}%\n  }%\n  \\vspace{0.20cm}%\n}\n\\setbeamertemplate{navigation symbols}{}\n\\AtBeginSection[]{}\n\n% ---- 字号与 itemize 样式 ------------------------------------\n\\setbeamerfont{title}{size=\\LARGE,series=\\bfseries}\n\\setbeamerfont{subtitle}{size=\\large}\n\\setbeamerfont{author}{size=\\Large}\n\\setbeamerfont{institute}{size=\\large}\n\\setbeamerfont{date}{size=\\normalsize}\n\\setlength{\\leftmargini}{1.4em}\n\\setbeamertemplate{itemize item}{\\scriptsize\\raise1.2pt\\hbox{\\color{cufenavy}\\textbullet}}\n\\setbeamertemplate{itemize subitem}{\\scriptsize\\raise1.2pt\\hbox{\\color{cufenavy}$\\circ$}}\n\\setbeamertemplate{itemize subsubitem}{\\scriptsize\\raise1.2pt\\hbox{\\color{cufenavy}$-$}}\n\n% ---- 元数据（替换为论文实际信息） ------------------------------\n\\title[%\n  [短标题·页脚用]%\n]{%\n  [论文全名 · 可长]%\n}\n\\subtitle{}\n\\author[%\n  [答辩人]%\n]{%\n  [答辩人]%\n}\n\\institute[%\n  [机构短名]%\n]{%\n  [机构全名]~~[年级 / 专业]\\\\[0.6em]\n  指导教师：[教师 1] 教授~~\\textbullet~~[教师 2] 教授%\n}\n\\date[%\n  [年份]%\n]{%\n  博士学位论文答辩~~[年份]%\n}\n\n% ============================================================\n\\begin{document}\n\n% ============================================================\n% 封面：大 logo + 居中标题（独立背景）\n% ============================================================\n{%\n  \\setbeamertemplate{background}{%\n    \\begin{tikzpicture}[overlay,remember picture]\n      \\fill[cufenavy]\n        (current page.north west) rectangle\n        ([yshift=-0.35cm]current page.north east);\n      \\node[anchor=north west,inner sep=0pt]\n        at ([xshift=0.7cm,yshift=-0.85cm]current page.north west)\n        {\\includegraphics[width=6.4cm,keepaspectratio]{figures/logo_cufe_full.png}};\n      \\draw[cuferule,line width=0.4pt]\n        ([yshift=0.85cm]current page.south west) --\n        ([yshift=0.85cm]current page.south east);\n    \\end{tikzpicture}%\n  }\n  \\begin{frame}[plain,noframenumbering]\n    \\vspace*{3.2cm}\n    \\begin{center}\n      {\\color{cufenavy}\\bfseries\\fontsize{24pt}{30pt}\\selectfont\n       [主标题第一行]\\\\[0.3em]\n       [主标题第二行]}\\\\[0.6em]\n\n      {\\color{cufenavy}\\itshape\\large\n       ——[副标题]}\n\n      \\vspace{1.2cm}\n      {\\color{cufetext}\\Large\\bfseries 答辩人：\\,[答辩人姓名]}\\\\[0.5em]\n      {\\color{cufetext}\\large 指导教师：[教师 1] 教授~~\\textbullet~~[教师 2] 教授}\\\\[0.4em]\n      {\\color{cufetext}\\normalsize [机构名]~~\\textbullet~~[年级 / 专业]}\n    \\end{center}\n    \\vfill\n    \\begin{center}\n      {\\color{cufenavy}\\normalsize\\bfseries 博士学位论文答辩~~\\textbullet~~[年份]}\n    \\end{center}\n  \\end{frame}\n}\n\n% ============================================================\n% 目录：页脚留空\n% ============================================================\n{%\n  \\setbeamertemplate{footline}{\\vbox to 0.9cm{\\vfill}}\n  \\begin{frame}[noframenumbering]{目录}\n    \\vspace{0.4em}\n    \\tableofcontents[hideallsubsections]\n  \\end{frame}\n}\n\n% ============================================================\n\\section{研究背景与问题}\n% ============================================================\n\n% ---- §1 背景段落帧（按时长扩充 2-8 帧） ------------------------\n\n\\begin{frame}{研究背景（一）：[背景主题 1]}\n  [首段：2--3 句话描述研究背景的第一个要点，关键词 \\textbf{粗体} 突出。]\n\n  \\vspace{0.4em}\n  [次段：2--3 句话描述第二个要点。\\textbf{粗体} 突出。]\n\n  \\vspace{0.4em}\n  [末段：收束句，\\textbf{突出研究锚点}。]\n\\end{frame}\n\n\\begin{frame}{研究背景（二）：[背景主题 2]}\n  [此处继续用段落文字描述背景。]\n\\end{frame}\n\n% ---- 研究问题 -----------------------------------------------\n\n\\begin{frame}{研究问题：一个核心问题 + N 条实证线索}\n  \\begin{block}{核心问题}\n    [一句话核心研究问题]\n  \\end{block}\n\n  \\vspace{0.4em}\n  \\begin{itemize}\n    \\item \\textbf{Q1（[属性 1]，第四章）} [问题描述]\n    \\item \\textbf{Q2（[属性 2]，第五章）} [问题描述]\n    \\item \\textbf{Q3（[属性 3]，第六章）} [问题描述]\n  \\end{itemize}\n\\end{frame}\n\n% ---- X → M → Y 框架帧（必填） ---------------------------------\n\n\\begin{frame}{研究框架：X → M → Y 的整体识别逻辑}\n\\vspace{-0.4em}\n\\begin{center}\n\\begin{tikzpicture}[\n    xbox/.style={draw, rounded corners, fill=blue!15, draw=blue!60!black,\n                 minimum width=2.8cm, minimum height=1.10cm,\n                 font=\\small\\bfseries, align=center},\n    mbox/.style={draw, rounded corners, fill=orange!12, draw=orange!70!black,\n                 minimum width=4.4cm, minimum height=0.70cm,\n                 font=\\scriptsize, align=center},\n    ybox/.style={draw, rounded corners, fill=green!15, draw=green!55!black,\n                 minimum width=2.6cm, minimum height=5.8cm,\n                 font=\\small\\bfseries, align=center},\n    arr/.style={-Latex, semithick, gray!70!black}]\n\n  \\node[xbox] (X1) at (0, 2.6)  {[X1]\\\\\\scriptsize 第四章 · [变量]};\n  \\node[xbox] (X2) at (0, 0)    {[X2]\\\\\\scriptsize 第五章 · [变量]};\n  \\node[xbox] (X3) at (0,-2.6)  {[X3]\\\\\\scriptsize 第六章 · [变量]};\n\n  \\node[mbox] (M1a) at (5.0, 3.0) {[通道 1a]};\n  \\node[mbox] (M1b) at (5.0, 2.2) {[通道 1b]};\n  \\node[mbox] (M2a) at (5.0, 0.4) {[通道 2a]};\n  \\node[mbox] (M2b) at (5.0,-0.4) {[通道 2b]};\n  \\node[mbox] (M3a) at (5.0,-2.2) {[通道 3a]};\n  \\node[mbox] (M3b) at (5.0,-3.0) {[通道 3b]};\n\n  \\node[ybox] (Y) at (10.2, 0) {[Y 标题]\\\\[0.5em]\n      \\scriptsize [Y 子变量]};\n\n  \\foreach \\x/\\m in {X1/M1a, X1/M1b, X2/M2a, X2/M2b, X3/M3a, X3/M3b}\n    \\draw[arr] (\\x.east) -- (\\m.west);\n  \\foreach \\m in {M1a, M1b, M2a, M2b, M3a, M3b}\n    \\draw[arr] (\\m.east) -- (Y.west);\n\\end{tikzpicture}\n\\end{center}\n\\vspace{-0.4em}\n{\\footnotesize 样本：[区间] [样本对象]，N = [观测数]。方法：[识别策略]。}\n\\end{frame}\n\n% ============================================================\n\\section{文献综述与理论基础}\n% ============================================================\n\n\\begin{frame}{文献脉络：两条主线 + 一处交叉空白}\n  \\textbf{主线 A：[主线 A 主题]}\n  \\begin{itemize}\n    \\item [派别 1] ([代表文献])：[论点]；\n    \\item [派别 2] ([代表文献])：[论点]。\n  \\end{itemize}\n\n  \\vspace{0.3em}\n  \\textbf{主线 B：[主线 B 主题]}\n  \\begin{itemize}\n    \\item [路径 1] ([代表文献])；\n    \\item [路径 2] ([代表文献])。\n  \\end{itemize}\n\n  \\vspace{0.3em}\n  \\textbf{交叉空白：} A $\\cap$ B —— \"[尚未被系统回答的问题]\" —— \\textbf{至今无系统回答}。\n\\end{frame}\n\n\\begin{frame}{理论基础：三视角一页对照}\n  \\centering\\scriptsize\n  \\setlength{\\tabcolsep}{4pt}\n  \\begin{tabular}{p{1.8cm} p{3.1cm} p{3.1cm} p{3.1cm}}\n    \\toprule\n              & \\textbf{第四章 · [X1]} & \\textbf{第五章 · [X2]} & \\textbf{第六章 · [X3]} \\\\\n    \\midrule\n    核心理论 & [理论 1]      & [理论 2]      & [理论 3]      \\\\\n    代表文献 & [文献 1]      & [文献 2]      & [文献 3]      \\\\\n    关键机制 & [通道描述 1]  & [通道描述 2]  & [通道描述 3]  \\\\\n    可检验预期 & [预期 1]    & [预期 2]      & [预期 3]      \\\\\n    \\bottomrule\n  \\end{tabular}\n\\end{frame}\n\n% ============================================================\n\\section{数据与变量}\n% ============================================================\n\n\\begin{frame}{数据与样本（一）：样本范围与区间选择}\n  \\textbf{研究对象：} [样本对象]；\\quad\n  \\textbf{观测：} [样本单位]，\\textbf{N = [观测数]}，[单位数]。\n\n  \\vspace{0.4em}\n  \\textbf{为什么是 [时间区间]？}\n  \\begin{itemize}\n    \\item \\textbf{起点：} [起点理由]；\n    \\item \\textbf{中部政策窗：} [关键政策事件]；\n    \\item \\textbf{终点：} [终点理由]。\n  \\end{itemize}\n\\end{frame}\n\n\\begin{frame}{变量定义：被解释变量与解释变量}\n  \\textbf{被解释变量 $Y$：} [Y 定义]\n\n  \\vspace{0.4em}\n  \\textbf{核心解释变量 $X$：}\n  \\begin{itemize}\n    \\item [X1]：[定义]\n    \\item [X2]：[定义]\n    \\item [X3]：[定义]\n  \\end{itemize}\n\n  \\vspace{0.3em}\n  \\textbf{控制变量：} [类别枚举]\n\n  \\vspace{0.3em}\n  \\textbf{固定效应：} [企业 FE + 行业$\\times$年份 FE]；\\textbf{标准误：} 企业层面聚类。\n\\end{frame}\n\n\\begin{frame}{描述性统计（核心变量 · N = [N]）}\n  \\centering\\scriptsize\n  \\setlength{\\tabcolsep}{4pt}\n  \\begin{tabular}{lccccccc}\n    \\toprule\n    变量 & 均值 & S.D. & 最小值 & Q25 & 中位数 & Q75 & 最大值 \\\\\n    \\midrule\n    [Y 变量]    & [值]  & [值] & [值]  & [值]  & [值]  & [值]  & [值]   \\\\\n    [X1]        & [值]  & [值] & [值]  & [值]  & [值]  & [值]  & [值]   \\\\\n    % ... 其余变量 ...\n    \\bottomrule\n  \\end{tabular}\n\n  \\vspace{0.4em}\n  \\footnotesize 资料来源：论文表 [X]。\n\\end{frame}\n\n% ============================================================\n\\section{[第四章实证标题]}\n% ============================================================\n\n\\begin{frame}{第四章 · 研究设计}\n  \\textbf{识别策略：} [DID / OLS / IV / PSM 描述]\n\n  \\vspace{0.4em}\n  \\textbf{计量模型：}\n  \\[\n    Y_{i,t} = \\alpha + \\beta\\,X_{i,t} + \\boldsymbol\\gamma\\mathbf{Z}_{i,t}\n    + \\mu_i + \\delta_{j\\times t} + \\varepsilon_{i,t}\n  \\]\n\n  \\vspace{0.3em}\n  \\textbf{关键参数：} $\\beta$ —— [解释]。\n\\end{frame}\n\n% ---- 基准 讨论 + 表 ---------------------------------------\n\n\\begin{frame}{第四章 · 基准结果讨论}\n  \\textbf{核心发现：}\n  \\begin{itemize}\n    \\item \\textbf{总体效应。} [X] 系数 $=$ \\textbf{[实际系数]$^{***}$}（$t=[t 值]$）；\n    \\item \\textbf{子样本拆分。} [结果描述]；\n    \\item \\textbf{控制变量方向。} [方向描述]。\n  \\end{itemize}\n\\end{frame}\n\n\\begin{frame}{第四章 · 基准回归表}\n\\centering\\scriptsize\n\\setlength{\\tabcolsep}{3.5pt}\n\\begin{tabular}{lcccccc}\n  \\toprule\n           & (1) & (2) & (3) & (4) & (5) & (6) \\\\\n           & [DV]& [DV]& [DV]& [DV]& [DV]& [DV]\\\\\n  \\midrule\n  [X]      & [β]$^{***}$ & [β]$^{***}$ & & & & \\\\\n           & ([t])       & ([t])       & & & & \\\\\n  \\midrule\n  Controls            & No  & Yes & No  & Yes & No  & Yes \\\\\n  Firm FE             & Yes & Yes & Yes & Yes & Yes & Yes \\\\\n  Ind $\\times$ Year FE& Yes & Yes & Yes & Yes & Yes & Yes \\\\\n  $N$                 & [N] & [N] & [N] & [N] & [N] & [N] \\\\\n  Adj.\\ $R^{2}$       & [R²]& [R²]& [R²]& [R²]& [R²]& [R²]\\\\\n  \\bottomrule\n\\end{tabular}\n\n\\vspace{0.4em}\n\\footnotesize 资料来源：论文表 [X]。$t$ 值在括号内；企业层面聚类稳健标准误。\n\\end{frame}\n\n% ---- 机制对（每个通道一对帧；按论文 N 通道复制） ----------------\n\n\\begin{frame}{第四章 · 机制（通道 A）：讨论}\n  \\textbf{[通道 A 名称]：} [传导路径描述]\n\n  \\vspace{0.3em}\n  \\begin{itemize}\n    \\item \\textbf{[代理变量 1]：} [描述]；\n    \\item \\textbf{[代理变量 2]：} [描述]；\n    \\item \\textbf{[代理变量 3]：} [描述]；\n    \\item \\textbf{[代理变量 4]：} [描述]。\n  \\end{itemize}\n\\end{frame}\n\n\\begin{frame}{第四章 · 机制（通道 A）：回归表}\n\\centering\\small\n\\begin{tabular}{lcccc}\n  \\toprule\n            & (1) & (2) & (3) & (4) \\\\\n            & [M1]& [M2]& [M3]& [M4] \\\\\n  \\midrule\n  [X]       & [β]$^{***}$ & [β]$^{***}$ & [β]$^{***}$ & [β]$^{**}$ \\\\\n            & ([t])       & ([t])       & ([t])       & ([t])      \\\\\n  \\midrule\n  Controls / Firm FE / Ind $\\times$ Year FE & Yes & Yes & Yes & Yes \\\\\n  $N$               & [N] & [N] & [N] & [N] \\\\\n  Adj.\\ $R^{2}$     & [R²]& [R²]& [R²]& [R²]\\\\\n  \\bottomrule\n\\end{tabular}\n\\end{frame}\n\n% ---- 异质性（每个维度 1 帧） ----------------------------------\n\n\\begin{frame}{第四章 · 异质性（一）：[维度 1 名称]}\n  \\textbf{维度：} [切分方式]；\\\\\n  \\textbf{发现：} [解读]。\n\n  \\vspace{0.3em}\n  \\centering\\small\n  \\begin{tabular}{lcc}\n    \\toprule\n              & (1) [高 / 组 1] & (2) [低 / 组 2] \\\\\n    \\midrule\n    [X]       & [β]$^{*}$ & [β